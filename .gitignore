# 各 skill 自带的嵌套 git 仓库：整体不入库，保留其本地 .git（未展平）
skills/claude-deep-research-skill/
skills/fireworks-tech-graph/
skills/humanizer-zh/
skills/nature-skills/
skills/repo-wiki/
skills/superpowers/
skills/web-access/

# 兜底：任何嵌套 .git 目录内容都不入库
**/.git/

# 本地缓存 / 迁移标记 / 临时文件
*.disable_to_model_invocation_migration.json
*.tmp
*.bak
__pycache__/
*.pyc

# 待删除文件暂存区：AI 只移入不删除，由用户手动清理，永不入库
.trash/
__trash__/

# web-access skill 本地用户配置（按 skill 设计不入库，可能含本地偏好）
config.env

# skill 运行态数据：执行日志、自动化记忆、浏览器自动化产物，随运行变化，不入库
skills/*/logs/
skills/*/.workbuddy/
skills/*/work/

# 操作系统 / 编辑器垃圾文件
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
